# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Smart-Prep API
APP_VERSION=1.0.0
DEBUG=true

# ── Database ───────────────────────────────────────────────────────────────────
# Using SQLite for local dev — swap for Supabase PostgreSQL URL in production
DATABASE_URL=sqlite:///./smartprep_dev.db

# ── JWT Auth ───────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-abc123
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Attendance Defaults ────────────────────────────────────────────────────────
DEFAULT_ATTENDANCE_THRESHOLD=75.0
